rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidUserProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() > 0;
    }
    
    // User profiles collection
    match /users/{userId} {
      // Users can read any profile (for contact discovery)
      allow read: if isAuthenticated();
      
      // Users can only write to their own profile
      allow write: if isOwner(userId) && isValidUserProfile();
      
      // Private user data - only accessible by owner
      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Conversations/Channels collection
    match /conversations/{conversationId} {
      // Allow users to read conversations they're part of
      allow read: if isAuthenticated() && 
        resource.data.participants.hasAll([request.auth.uid]);
      
      // Allow creating conversations if user is part of it
      allow create: if isAuthenticated() && 
        request.resource.data.participants.hasAll([request.auth.uid]);
      
      // Allow updates only to participants
      allow update: if isAuthenticated() && 
        resource.data.participants.hasAll([request.auth.uid]);
      
      // Messages in conversations
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAll([request.auth.uid]);
        
        allow create: if isAuthenticated() && 
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAll([request.auth.uid]);
        
        allow update, delete: if isOwner(resource.data.senderId);
      }
    }
    
    // Contacts collection
    match /contacts/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      
      match /requests/{requestId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId);
      }
    }
    
    // User settings/preferences
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Blocked users
    match /blocked/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // App-wide data (read-only for authenticated users)
    match /app/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin via Firebase Admin SDK
    }
  }
}
